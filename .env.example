VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Optional per-app overrides. An open app falls back to the shared pair above;
# a closed app (open: false in src/config/apps.ts) never does, and has no
# backend until its own two variables are set. Developer pages use the shared pair.
# VITE_SUPABASE_URL_HOUSE_PARTY=https://your-house-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY_HOUSE_PARTY=sb_publishable_your_key
# VITE_SUPABASE_URL_BDAY_HUNT=https://your-bday-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY_BDAY_HUNT=sb_publishable_your_key

# The party passphrase and the host PIN are not environment variables. Both are
# bcrypt-hashed inside Postgres and set only from the Supabase SQL Editor with
# set_party_passphrase() and set_host_pin(). Never put either one in this file.
